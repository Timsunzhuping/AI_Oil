// =============================================================================
// FluidMind Prisma schema (placeholder — regenerated via `prisma db pull`)
// =============================================================================
//
// The CANONICAL schema lives in plain SQL migrations under
//   infra/db/migrations/0001_init_extensions.sql … 0010_ml_registry.sql
//
// Prisma is used here only as a typed client over the live database.
// To regenerate this file from the actual schema:
//
//   pnpm -F @fluidmind/backend prisma db pull
//   pnpm -F @fluidmind/backend prisma generate
//
// Do NOT hand-edit this file — changes will be overwritten by `db pull`.
// All schema changes go through SQL migrations.
//
// See infra/db/ERD.md for a full domain reference.
// =============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}
