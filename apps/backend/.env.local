# Local development environment
# Loaded when NODE_ENV=local (default)
# Override with .env.local.local (gitignored) for personal overrides

NODE_ENV=local
PORT=3001
LOG_LEVEL=debug
SERVICE_NAME=fluidmind-backend
SERVICE_VERSION=0.0.1

DATABASE_URL=postgresql://fluidmind:fluidmind_dev@localhost:5432/fluidmind_dev
REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:3000
API_PREFIX=/api

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

ENABLE_SWAGGER=true
ENABLE_REQUEST_LOGGING=true
