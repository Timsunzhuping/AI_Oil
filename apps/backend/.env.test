# Test environment
# Loaded when NODE_ENV=test
# Used by vitest and CI

NODE_ENV=test
PORT=3099
LOG_LEVEL=error
SERVICE_NAME=fluidmind-backend-test
SERVICE_VERSION=0.0.1-test

DATABASE_URL=postgresql://fluidmind:fluidmind_test@localhost:5432/fluidmind_test
REDIS_URL=redis://localhost:6379/1

CORS_ORIGIN=http://localhost:3000
API_PREFIX=/api

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10000

ENABLE_SWAGGER=false
ENABLE_REQUEST_LOGGING=false
