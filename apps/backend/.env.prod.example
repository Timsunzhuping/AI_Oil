# Production environment template
# Copy to .env.prod and fill in real values - .env.prod is gitignored
# Loaded when NODE_ENV=prod
# In Kubernetes, use ConfigMap + Secret instead of .env files

NODE_ENV=prod
PORT=3001
LOG_LEVEL=info
SERVICE_NAME=fluidmind-backend
SERVICE_VERSION=__INJECTED_AT_BUILD__

# Use secret store / k8s secrets in real deployment
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fluidmind
REDIS_URL=redis://HOST:6379

# Production CORS origin (no localhost)
CORS_ORIGIN=https://app.fluidmind.example.com
API_PREFIX=/api

# Tighter rate limits in prod
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=60

# Swagger disabled in prod (or behind auth)
ENABLE_SWAGGER=false
ENABLE_REQUEST_LOGGING=true

# Observability - inject from secret
SENTRY_DSN=
DATADOG_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4318
