# FluidMind Workbench — environment variables
# Copy to `.env.local` for local development.

# Set to 1 to force the mock adapters and skip real API calls. Useful
# when developing the UI without the backend running.
NEXT_PUBLIC_USE_MOCK=0

# Override the API base URL. When unset, requests go to /api/v1 and are
# proxied to BACKEND_URL by next.config.js rewrites.
# NEXT_PUBLIC_API_BASE=https://staging.example.com/api/v1

# Backend URL for the dev rewrite (server-side only).
BACKEND_URL=http://localhost:3001
